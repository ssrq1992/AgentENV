+package scheduler
+
+import (
+	schedulerv1 "agentenv/services/api/proto"
+	"context"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+	"testing"
+	"time"
+)
+
+type testControlPlugin struct{ count int }
+
+func (p *testControlPlugin) Schedule(ctx context.Context, q *schedulerv1.ScheduleRequest, nodes []RichNode, choose func([]RichNode) (RichNode, error)) (*schedulerv1.ScheduleResponse, error) {
+	p.count = len(nodes)
+	n, err := choose(nodes)
+	if err != nil {
+		return nil, err
+	}
+	return &schedulerv1.ScheduleResponse{Node: n.ToProto(), StorageDispatch: []byte("signed")}, nil
+}
+func (*testControlPlugin) Invoke(context.Context, []byte) ([]byte, error) { return nil, nil }
+func TestStorageAdmissionKeepsNativeDiscoveryAndStrategy(t *testing.T) {
+	registry := NewAtomicNodeRegistry([]Node{{ID: "ready", Endpoint: "http://ready"}, {ID: "unobserved", Endpoint: "http://unknown"}}, time.Minute)
+	_, _, err := registry.Heartbeat(&schedulerv1.HeartbeatRequest{NodeId: "ready", ServiceInstanceId: "boot", Snapshot: &schedulerv1.NodeSnapshot{Status: schedulerv1.NodeStatus_NODE_STATUS_READY}, SandboxIds: []string{"native-id"}}, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	plugin := &testControlPlugin{}
+	s := NewService(nil, registry, &RoundRobinStrategy{}, nil, WithControlPlugin(plugin))
+	result, err := s.Schedule(context.Background(), &schedulerv1.ScheduleRequest{StorageIntent: []byte("signed")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if plugin.count != 1 || result.Node.NodeId != "ready" {
+		t.Fatal("plugin bypassed native discovery/health")
+	}
+	observed, ok := registry.GetObserved("ready", "", time.Now())
+	if !ok || len(observed.SandboxIds) != 1 || observed.SandboxIds[0] != "native-id" {
+		t.Fatal("heartbeat instances lost")
+	}
+	disabled := NewService(nil, registry, &RoundRobinStrategy{}, nil)
+	if _, err = disabled.Schedule(context.Background(), &schedulerv1.ScheduleRequest{StorageIntent: []byte("signed")}); status.Code(err) != codes.FailedPrecondition {
+		t.Fatal("storage silently bypassed", err)
+	}
+}
diff --git a/services/shared/storage/protocol.go b/services/shared/storage/protocol.go
new file mode 100644
index 0000000..efecb51
--- /dev/null
+++ b/services/shared/storage/protocol.go
@@ -0,0 +1,139 @@
+// Package storage defines the optional native storage plugin protocol. It has
+// no Kubernetes or CSI dependency and is also used by the plugin-disabled build.
+package storage
+
+import (
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+)
+
+const Version = "agentenv.storage.v2"
+const ContextHeader = "X-Agentenv-Storage-Context"
+const MaxEnvelopeBytes = 1 << 20
+const MaxBodyBytes = 512 << 10
+
+type Envelope struct {
+	Version   string          `json:"version"`
+	Role      string          `json:"role"`
+	RequestID string          `json:"request_id"`
+	IssuedAt  int64           `json:"issued_at"`
+	Payload   json.RawMessage `json:"payload"`
+	Signature string          `json:"signature"`
+}
+
+type LaunchIntent struct {
+	Method     string `json:"method"`
+	Path       string `json:"path"`
+	Body       []byte `json:"body"`
+	BodyDigest string `json:"body_digest"`
+	// A native node may request admission on its existing placement for resume,
+	// template builds, or Fork; a public caller cannot choose this field.
+	NodeID  string `json:"node_id,omitempty"`
+	OwnerID string `json:"owner_id,omitempty"`
+}
+
+type Command struct {
+	Action  string          `json:"action"`
+	NodeID  string          `json:"node_id"`
+	OwnerID string          `json:"owner_id,omitempty"`
+	RunID   string          `json:"run_id,omitempty"`
+	Data    json.RawMessage `json:"data"`
+}
+
+func Digest(b []byte) string { h := sha256.Sum256(b); return hex.EncodeToString(h[:]) }
+func NewRequestID() (string, error) {
+	b := make([]byte, 24)
+	if _, err := rand.Read(b); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(b), nil
+}
+func LoadKey(path string) ([]byte, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	b = []byte(strings.TrimSpace(string(b)))
+	if len(b) < 32 {
+		return nil, errors.New("storage authentication key must contain at least 32 bytes")
+	}
+	return b, nil
+}
+func Sign(key []byte, role, id string, payload any, now time.Time) ([]byte, error) {
+	if len(key) < 32 || role == "" || id == "" {
+		return nil, errors.New("storage signing identity required")
+	}
+	p, err := json.Marshal(payload)
+	if err != nil {
+		return nil, err
+	}
+	e := Envelope{Version: Version, Role: role, RequestID: id, IssuedAt: now.Unix(), Payload: p}
+	raw, err := json.Marshal(e)
+	if err != nil {
+		return nil, err
+	}
+	m := hmac.New(sha256.New, key)
+	_, _ = m.Write(raw)
+	e.Signature = base64.RawURLEncoding.EncodeToString(m.Sum(nil))
+	raw, err = json.Marshal(e)
+	if len(raw) > MaxEnvelopeBytes {
+		return nil, errors.New("storage envelope exceeds limit")
+	}
+	return raw, err
+}
+func Verify(key, raw []byte, role string, now time.Time) (Envelope, error) {
+	var e Envelope
+	if len(key) < 32 || len(raw) == 0 || len(raw) > MaxEnvelopeBytes {
+		return e, errors.New("invalid storage envelope size or key")
+	}
+	if err := json.Unmarshal(raw, &e); err != nil {
+		return e, err
+	}
+	if e.Version != Version || e.Role != role || e.RequestID == "" {
+		return e, errors.New("storage protocol or role mismatch")
+	}
+	age := now.Sub(time.Unix(e.IssuedAt, 0))
+	if age < -30*time.Second || age > 5*time.Minute {
+		return e, errors.New("storage envelope expired")
+	}
+	sig, err := base64.RawURLEncoding.DecodeString(e.Signature)
+	if err != nil {
+		return e, err
+	}
+	unsigned := e
+	unsigned.Signature = ""
+	b, err := json.Marshal(unsigned)
+	if err != nil {
+		return e, err
+	}
+	m := hmac.New(sha256.New, key)
+	_, _ = m.Write(b)
+	if !hmac.Equal(sig, m.Sum(nil)) {
+		return e, errors.New("storage signature mismatch")
+	}
+	return e, nil
+}
+func (i LaunchIntent) Validate() error {
+	if i.Method != "POST" || len(i.Body) == 0 || len(i.Body) > MaxBodyBytes || Digest(i.Body) != i.BodyDigest {
+		return errors.New("invalid native launch body")
+	}
+	switch i.Path {
+	case "/sandboxes-cold", "/sandboxes", "/v2/sandboxes":
+	default:
+		return fmt.Errorf("unsupported launch path %q", i.Path)
+	}
+	var body map[string]json.RawMessage
+	if err := json.Unmarshal(i.Body, &body); err != nil || body == nil {
+		return errors.New("native launch body must be an object")
+	}
+	return nil
+}
diff --git a/services/shared/storage/protocol_test.go b/services/shared/storage/protocol_test.go
new file mode 100644
index 0000000..ecb2416
--- /dev/null
+++ b/services/shared/storage/protocol_test.go
@@ -0,0 +1,43 @@
+package storage
+
+import (
+	"bytes"
+	"encoding/json"
+	"testing"
+	"time"
+)
+
+func TestAuthenticatedIntent(t *testing.T) {
+	key := bytes.Repeat([]byte("k"), 32)
+	now := time.Now()
+	body := []byte(`{ "volumeMounts": [], "image": "original" }`)
+	intent := LaunchIntent{Method: "POST", Path: "/sandboxes-cold", Body: body, BodyDigest: Digest(body)}
+	signed, err := Sign(key, "gateway", "request", intent, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	e, err := Verify(key, signed, "gateway", now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded LaunchIntent
+	if err = json.Unmarshal(e.Payload, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if err = decoded.Validate(); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(decoded.Body, body) {
+		t.Fatal("original body changed")
+	}
+	if _, err = Verify(key, signed, "node", now); err == nil {
+		t.Fatal("role confusion")
+	}
+	if _, err = Verify(key, signed, "gateway", now.Add(6*time.Minute)); err == nil {
+		t.Fatal("expired envelope")
+	}
+	signed = bytes.Replace(signed, []byte("request"), []byte("changed"), 1)
+	if _, err = Verify(key, signed, "gateway", now); err == nil {
+		t.Fatal("tampering accepted")
+	}
+}
diff --git a/src/api/impls/storage.rs b/src/api/impls/storage.rs
new file mode 100644
index 0000000..7d2b94e
--- /dev/null
+++ b/src/api/impls/storage.rs
@@ -0,0 +1,142 @@
+//! Read-only projection for storage-aware scheduling; SnapshotManager remains
+//! the authority for template aliases and immutable runnable versions.
+use super::ApiImpl;
+use axum::{
+    Router,
+    extract::{Path, State},
+    http::StatusCode,
+    response::{IntoResponse, Response},
+    routing::get,
+};
+
+pub(crate) fn router<I>(api: I) -> Router
+where
+    I: AsRef<ApiImpl> + Clone + Send + Sync + 'static,
+{
+    Router::new()
+        .route("/internal/storage/defaults", get(project_defaults))
+        .route("/internal/storage/capacity", get(project_capacity::<I>))
+        .route(
+            "/internal/storage/checkpoints/{reference}",
+            get(project_checkpoint::<I>),
+        )
+        .route(
+            "/internal/storage/templates/{reference}",
+            get(project_template::<I>),
+        )
+        .with_state(api)
+}
+async fn project_template<I>(State(api): State<I>, Path(reference): Path<String>) -> Response
+where
+    I: AsRef<ApiImpl> + Clone + Send + Sync + 'static,
+{
+    if !crate::cfg::ConfigManager::global_config()
+        .storage_provider
+        .enabled
+    {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    let api = api.as_ref();
+    match api.snapshot_manager.get(&reference).await {
+        Ok(Some(record)) => {
+            let Some(committed) = &record.committed else {
+                return StatusCode::CONFLICT.into_response();
+            };
+            if committed.virtualization_mode
+                != crate::cfg::ConfigManager::global_config().virtualization_mode
+            {
+                return StatusCode::CONFLICT.into_response();
+            }
+            let checkpoint = match &committed.storage_checkpoint {
+                Some(value) => match value
+                    .get("reference")
+                    .and_then(serde_json::Value::as_str)
+                    .filter(|id| !id.is_empty())
+                {
+                    Some(id) => id,
+                    None => return StatusCode::CONFLICT.into_response(),
+                },
+                None => "",
+            };
+            axum::Json(serde_json::json!({
+                "id": record.id.to_string(),
+                "resources": {"cpu": record.resources.cpu_count, "memory_mib": record.resources.memory_mib},
+                "volumeMounts": [], "checkpoint_id": checkpoint,
+            })).into_response()
+        }
+        Ok(None) => StatusCode::NOT_FOUND.into_response(),
+        Err(err) => (
+            StatusCode::CONFLICT,
+            axum::Json(serde_json::json!({"code":409,"message":err.to_string()})),
+        )
+            .into_response(),
+    }
+}
+
+async fn project_defaults() -> Response {
+    let config = crate::cfg::ConfigManager::global_config();
+    if !config.storage_provider.enabled {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    axum::Json(serde_json::json!({"cpu":config.machine.vcpu_count,"memory_mib":config.machine.mem_size_mib,"storage_protocol":"agentenv.storage.v2","storage_hook_version":4})).into_response()
+}
+
+// An explicit repository observation, unlike a routing/authentication 404.
+async fn project_checkpoint<I>(State(api): State<I>, Path(reference): Path<String>) -> Response
+where
+    I: AsRef<ApiImpl> + Clone + Send + Sync + 'static,
+{
+    if !crate::cfg::ConfigManager::global_config()
+        .storage_provider
+        .enabled
+    {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    if uuid::Uuid::parse_str(&reference).is_err() {
+        return StatusCode::BAD_REQUEST.into_response();
+    }
+    let repository_id = match api.as_ref().snapshot_manager.storage_repository_id().await {
+        Ok(id) => id,
+        Err(error) => return (StatusCode::SERVICE_UNAVAILABLE, error.to_string()).into_response(),
+    };
+    match api.as_ref().snapshot_manager.get(&reference).await {
+        Ok(record) => axum::Json(serde_json::json!({
+            "id": reference,
+            "repository_id": repository_id,
+            "exists": record.is_some(),
+            "committed": record.as_ref().is_some_and(|record| record.committed.is_some()),
+        }))
+        .into_response(),
+        Err(error) => (StatusCode::SERVICE_UNAVAILABLE, error.to_string()).into_response(),
+    }
+}
+
+// Admission accounting is separate from routing/heartbeat IDs: those include
+// dormant builders and are sampled independently of their resource totals.
+async fn project_capacity<I>(State(api): State<I>) -> Response
+where
+    I: AsRef<ApiImpl> + Clone + Send + Sync + 'static,
+{
+    if !crate::cfg::ConfigManager::global_config()
+        .storage_provider
+        .enabled
+    {
+        return StatusCode::NOT_FOUND.into_response();
+    }
+    let api = api.as_ref();
+    let result = async {
+        let observability = api.observability().ok_or_else(|| anyhow::anyhow!("native capacity observation unavailable"))?;
+        let host = observability.node_snapshot().await?;
+        let (allocated, ids) = api.orchestrator.storage_allocation_snapshot().await?;
+        Ok::<_, anyhow::Error>(serde_json::json!({
+            "version": 1, "node_id": host.node_id,
+            "capacity": {"cpu": host.metrics.cpu_count, "memory_mib": host.metrics.memory_total_bytes / (1024 * 1024)},
+            "allocated": {"cpu": allocated.allocated_cpu, "memory_mib": allocated.allocated_memory_bytes.div_ceil(1024 * 1024)},
+            "sandbox_ids": ids.iter().map(ToString::to_string).collect::<Vec<_>>(),
+        }))
+    }.await;
+    match result {
+        Ok(value) => axum::Json(value).into_response(),
+        Err(error) => (StatusCode::SERVICE_UNAVAILABLE, error.to_string()).into_response(),
+    }
+}
