+    pub(crate) fn persist_storage_reservation_cleanup(
+        &self,
+        context: &crate::sandbox::storage::StorageContext,
+        owner: &str,
+        volumes: &[String],
+    ) -> Result<(), VolumeError> {
+        use std::io::Write;
+        let task = PrivateReservationCleanup {
+            owner: owner.to_owned(),
+            volumes: volumes.to_vec(),
+            context: context.clone(),
+        };
