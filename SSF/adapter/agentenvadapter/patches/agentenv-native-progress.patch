@@ -0,0 +1,83 @@
+//! Native VolumeProviderMux helpers. Provider commands remain opaque to the
+//! runtime; only the ordinary public Volume model crosses this boundary.
+use agentenv_http_server::models;
+use anyhow::{Context, Result};
+use serde::Deserialize;
+use serde_json::{json, Value};
+
+pub(super) fn enabled() -> bool {
+    crate::cfg::ConfigManager::global_config()
+        .storage_provider
+        .enabled
+}
+
+pub(super) async fn lookup(name: &str) -> Result<Option<models::Volume>> {
+    if !enabled() {
+        return Ok(None);
+    }
+    #[derive(Deserialize)]
+    struct Lookup {
+        found: bool,
+        volume: Option<models::Volume>,
+    }
+    let response: Lookup = serde_json::from_value(
+        crate::sandbox::storage::volume_command("lookup", json!({"name":name})).await?,
+    )?;
+    if response.found {
+        Ok(Some(
+            response.volume.context("provider omitted known volume")?,
+        ))
+    } else {
+        Ok(None)
+    }
+}
+
+pub(super) async fn list() -> Result<Vec<models::Volume>> {
+    if !enabled() {
+        return Ok(Vec::new());
+    }
+    Ok(serde_json::from_value(
+        crate::sandbox::storage::volume_command("list", json!({})).await?,
+    )?)
+}
+
+pub(super) async fn claim_legacy(name: &str) -> Result<()> {
+    if enabled() {
+        crate::sandbox::storage::volume_command("claim_legacy", json!({"name":name})).await?;
+    }
+    Ok(())
+}
+
+pub(super) async fn create(body: &models::NewVolume) -> Result<models::Volume> {
+    anyhow::ensure!(enabled(), "storage provider is disabled");
+    anyhow::ensure!(
+        body.image.is_none() && body.from_volume.is_none(),
+        "provider image initialization and live volume clone require an explicit supported source"
+    );
+    let bytes = body
+        .size_mb
+        .unwrap_or(crate::volume::DEFAULT_VOLUME_SIZE_MB)
+        .checked_mul(1024 * 1024)
+        .filter(|n| *n <= i64::MAX as u64)
+        .context("volume capacity exceeds provider range")?;
+    let mut request = serde_json::Map::new();
+    if let Some(options) = &body.storage {
+        for (key, value) in options {
+            request.insert(key.clone(), value.0.clone());
+        }
+    }
+    // Public identity and access mode cannot be overridden by provider options.
+    request.insert("provider".into(), json!(body.provider));
+    request.insert("name".into(), json!(body.name));
+    request.insert("bytes".into(), json!(bytes));
+    request.insert("readonly".into(), json!(body.mode.as_deref() == Some("ro")));
+    Ok(serde_json::from_value(
+        crate::sandbox::storage::volume_command("create", Value::Object(request)).await?,
+    )?)
+}
+
+pub(super) async fn delete(name: &str) -> Result<()> {
+    anyhow::ensure!(enabled(), "storage provider is disabled");
+    crate::sandbox::storage::volume_command("delete", json!({"name": name})).await?;
+    Ok(())
+}
diff --git a/src/sandbox/storage/artifact_gc.rs b/src/sandbox/storage/artifact_gc.rs
new file mode 100644
index 0000000..13cb231
--- /dev/null
+++ b/src/sandbox/storage/artifact_gc.rs
@@ -0,0 +1,327 @@
+//! Generic native artifact retirement. Only the original runtime removes files;
+//! provider receipts protect checkpoint consumers and contain no filesystem paths.
+use super::{client, endpoint, StorageContext};
+use crate::cfg::ConfigManager;
+use anyhow::{Context, Result};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    fs::{self, File},
+    io::Write,
+    path::{Path, PathBuf},
+    sync::Once,
+};
+
+#[derive(Clone, Serialize, Deserialize)]
+struct Capture {
+    context: StorageContext,
+    barrier: String,
+    directory: PathBuf,
+}
+#[derive(Serialize, Deserialize)]
+struct Task {
+    root: PathBuf,
+    pid: u32,
+    start: String,
+    wanted: bool,
+    latest: Capture,
+    #[serde(default)]
+    captures: Vec<Capture>,
+}
+
+fn task_root() -> PathBuf {
+    ConfigManager::global_config()
+        .storage_provider
+        .state_dir
+        .join("artifact_gc")
+}
+fn task_path(root: &Path) -> PathBuf {
+    task_root().join(format!(
+        "{:x}.json",
+        Sha256::digest(root.as_os_str().as_encoded_bytes())
+    ))
+}
+fn process_start(pid: u32) -> Result<String> {
+    let value = fs::read_to_string(format!("/proc/{pid}/stat"))?;
+    Ok(value
+        .rsplit_once(')')
+        .context("process identity missing")?
+        .1
+        .split_whitespace()
+        .nth(19)
+        .context("process identity truncated")?
+        .to_owned())
+}
+fn write_atomic(path: &Path, value: &impl Serialize) -> Result<()> {
+    let parent = path.parent().context("task parent missing")?;
+    fs::create_dir_all(parent)?;
+    if let Some(ancestor) = parent.parent() {
+        File::open(ancestor)?.sync_all()?;
+    }
+    let mut temporary = tempfile::NamedTempFile::new_in(parent)?;
+    temporary.write_all(&serde_json::to_vec(value)?)?;
+    temporary.as_file().sync_all()?;
+    temporary.persist(path).map_err(|error| error.error)?;
+    File::open(parent)?.sync_all()?;
+    Ok(())
+}
+
+pub(crate) fn retain(directory: &Path, context: &StorageContext, barrier: &str) -> Result<()> {
+    let directory = directory.canonicalize()?;
+    let root = directory
+        .parent()
+        .context("capture root missing")?
+        .to_path_buf();
+    let capture = Capture {
+        context: context.clone(),
+        barrier: barrier.to_owned(),
+        directory: directory.clone(),
+    };
+    let mut captures = match fs::read(task_path(&root)) {
+        Ok(raw) => {
+            let prior: Task = serde_json::from_slice(&raw)?;
+            anyhow::ensure!(prior.root == root, "artifact root identity changed");
+            let mut captures = prior.captures;
+            if !captures
+                .iter()
+                .any(|capture| capture.directory == prior.latest.directory)
+            {
+                captures.push(prior.latest);
+            }
+            captures
+        }
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Vec::new(),
+        Err(error) => return Err(error.into()),
+    };
+    anyhow::ensure!(
+        !captures
+            .iter()
+            .any(|capture| capture.directory == directory),
+        "capture directory reused"
+    );
+    captures.push(capture.clone());
+    // Persist recovery identity before marking or issuing the provider request.
+    write_atomic(
+        &task_path(&root),
+        &Task {
+            root: root.clone(),
+            pid: std::process::id(),
+            start: process_start(std::process::id())?,
+            wanted: false,
+            latest: capture.clone(),
+            captures,
+        },
+    )?;
+    super::artifacts::retain_capture(&directory)?;
+    write_atomic(&directory.join(super::artifacts::RETAIN_MARKER), &capture)?;
+    Ok(())
+}
+
+pub(crate) fn request(root: &Path) -> Result<()> {
+    let root = root.canonicalize()?;
+    let path = task_path(&root);
+    let mut task: Task = serde_json::from_slice(&fs::read(&path)?)?;
+    anyhow::ensure!(task.root == root, "artifact task identity changed");
+    task.wanted = true;
+    write_atomic(&path, &task)
+}
+
+async fn retire(capture: &Capture) -> Result<bool> {
+    let reply:serde_json::Value=client()?.post(endpoint("/storage/control")?)
+        .json(&serde_json::json!({"ticket":capture.context.ticket,"action":"capture.retire","capture":{"barrier_id":capture.barrier}}))
+        .send().await?.error_for_status()?.json().await?;
+    reply
+        .get("collectible")
+        .and_then(serde_json::Value::as_bool)
+        .context("artifact retirement receipt missing")
+}
+
+async fn advance(path: &Path) -> Result<()> {
+    anyhow::ensure!(
+        fs::metadata(path)?.len() <= 64 * 1024 * 1024,
+        "oversized artifact task"
+    );
+    let raw = fs::read(path)?;
+    anyhow::ensure!(raw.len() <= 64 * 1024 * 1024, "oversized artifact task");
+    let task: Task = serde_json::from_slice(&raw)?;
+    anyhow::ensure!(
+        task_path(&task.root) == path && task.root.is_absolute(),
+        "invalid artifact task path"
+    );
+    if !task.wanted && process_start(task.pid).is_ok_and(|start| start == task.start) {
+        return Ok(());
+    }
+    if !task.root.try_exists()? {
+        for capture in task.captures.iter().chain(std::iter::once(&task.latest)) {
+            if !retire(capture).await? {
+                return Ok(());
+            }
+        }
+        fs::remove_file(path)?;
+        File::open(task_root())?.sync_all()?;
+        return Ok(());
+    }
+    anyhow::ensure!(
+        task.root.canonicalize()? == task.root,
+        "artifact root became a symlink"
+    );
+    let mut captures = task.captures.clone();
+    for child in fs::read_dir(&task.root)? {
+        let child = child?;
+        if !child.file_type()?.is_dir() {
+            continue;
+        }
+        let marker = child.path().join(super::artifacts::RETAIN_MARKER);
+        if !marker.try_exists()? {
+            continue;
+        }
+        anyhow::ensure!(
+            fs::symlink_metadata(&marker)?.is_file(),
+            "artifact marker is not a regular file"
+        );
+        let raw = fs::read(&marker)?;
+        anyhow::ensure!(raw.len() <= 1024 * 1024, "oversized artifact marker");
+        let capture: Capture = match serde_json::from_slice(&raw) {
+            Ok(capture) => capture,
+            Err(_) if child.path() == task.latest.directory => task.latest.clone(),
+            Err(error) => return Err(error.into()),
+        };
+        anyhow::ensure!(
+            capture.directory == child.path(),
+            "capture directory identity changed"
+        );
+        if let Some(prior) = captures
+            .iter()
+            .find(|prior| prior.directory == capture.directory)
+        {
+            anyhow::ensure!(
+                prior.barrier == capture.barrier
+                    && prior.context.request_id == capture.context.request_id,
+                "capture marker identity changed"
+            );
+        } else {
+            captures.push(capture);
+        }
+    }
+    if !captures
+        .iter()
+        .any(|capture| capture.directory == task.latest.directory)
+    {
+        captures.push(task.latest.clone());
+    }
+    for capture in &captures {
+        if !retire(capture).await? {
+            return Ok(());
+        }
+    }
+    // All original owner runs are terminal and no template/child retains the
+    // native artifact. The immutable root cannot be reused by a new sandbox.
+    anyhow::ensure!(
+        task.root.canonicalize()? == task.root,
+        "artifact root changed during retirement"
+    );
+    fs::remove_dir_all(&task.root)?;
+    if let Some(parent) = task.root.parent() {
+        File::open(parent)?.sync_all()?;
+    }
+    fs::remove_file(path)?;
+    File::open(task_root())?.sync_all()?;
+    Ok(())
+}
+
+pub(crate) fn start() {
+    static START: Once = Once::new();
+    if !ConfigManager::global_config().storage_provider.enabled {
+        return;
+    }
+    let Ok(handle) = tokio::runtime::Handle::try_current() else {
+        return;
+    };
+    START.call_once(|| {
+        handle.spawn(async {
+            let mut tick = tokio::time::interval(std::time::Duration::from_secs(5));
+            loop {
+                tick.tick().await;
+                let entries = match fs::read_dir(task_root()) {
+                    Ok(entries) => entries,
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => continue,
+                    Err(error) => {
+                        tracing::warn!(%error,"artifact retirement scan failed");
+                        continue;
+                    }
+                };
+                for entry in entries {
+                    let Ok(entry) = entry else {
+                        continue;
+                    };
+                    if entry.file_type().is_ok_and(|kind| kind.is_file())
+                        && entry
+                            .path()
+                            .extension()
+                            .is_some_and(|extension| extension == "json")
+                    {
+                        if let Err(error) = advance(&entry.path()).await {
+                            tracing::debug!(%error,"native artifact retirement retained");
+                        }
+                    }
+                }
+            }
+        });
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn artifact_task_atomic_write_preserves_all_capture_identities() -> Result<()> {
+        let temporary = tempfile::tempdir()?;
+        let path = temporary.path().join("tasks/task.json");
+        let context = StorageContext {
+            ticket: "private-ticket".into(),
+            owner_uid: "owner".into(),
+            run_uid: "run".into(),
+            request_id: "request".into(),
+            template_pin: String::new(),
+            checkpoint_source: String::new(),
+            managed_mounts: Vec::new(),
+            native_id: String::new(),
+            replace_mounts: false,
+            relocations: Vec::new(),
+        };
+        let first = Capture {
+            context: context.clone(),
+            barrier: "one".into(),
+            directory: temporary.path().join("root/one"),
+        };
+        let second = Capture {
+            context,
+            barrier: "two".into(),
+            directory: temporary.path().join("root/two"),
+        };
+        let mut task = Task {
+            root: temporary.path().join("root"),
+            pid: std::process::id(),
+            start: "start".into(),
+            wanted: false,
+            latest: second.clone(),
+            captures: vec![first, second],
+        };
+        write_atomic(&path, &task)?;
+        task.wanted = true;
+        write_atomic(&path, &task)?;
+        let reopened: Task = serde_json::from_slice(&fs::read(&path)?)?;
+        assert!(reopened.wanted);
+        assert_eq!(reopened.captures.len(), 2);
+        assert_eq!(reopened.captures[0].barrier, "one");
+        assert_eq!(reopened.latest.barrier, "two");
+        assert_eq!(fs::read_dir(path.parent().unwrap())?.count(), 1);
+        Ok(())
+    }
+    #[test]
+    fn artifact_owner_identity_requires_live_exact_process() -> Result<()> {
+        assert!(!process_start(std::process::id())?.is_empty());
+        assert!(process_start(u32::MAX).is_err());
+        Ok(())
+    }
+}
diff --git a/src/sandbox/storage/artifacts.rs b/src/sandbox/storage/artifacts.rs
new file mode 100644
index 0000000..874e68e
--- /dev/null
+++ b/src/sandbox/storage/artifacts.rs
@@ -0,0 +1,121 @@
+//! A local marker prevents native artifact GC from outrunning provider
+//! checkpoint reconciliation. Only explicit checkpoint GC may remove it.
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Write};
+use std::os::unix::fs::OpenOptionsExt;
+use std::path::Path;
+
+pub const RETAIN_MARKER: &str = ".storage-checkpoint-retained";
+
+pub fn persist_repository_observation(
+    root: &Path,
+    repository: &str,
+    id: &str,
+    action: &str,
+) -> io::Result<()> {
+    if repository.len() != 64
+        || !repository
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+        || id.is_empty()
+        || id.len() > 128
+        || !id
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+        || !matches!(action, "published" | "deleted")
+    {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid repository task",
+        ));
+    }
+    fs::create_dir_all(root)?;
+    if let Some(parent) = root.parent() {
+        File::open(parent)?.sync_all()?;
+    }
+    let target = root.join(format!("{repository}_{id}-{action}.json"));
+    // NamedTempFile creates a private, unique file in the same directory, so
+    // concurrent retries cannot truncate each other's incomplete writes.
+    let mut temporary = tempfile::NamedTempFile::new_in(root)?;
+    temporary.write_all(&serde_json::to_vec(&serde_json::json!({
+        "version": 1, "action": action, "native_id": id, "repository_id": repository,
+    }))?)?;
+    temporary.as_file().sync_all()?;
+    temporary.persist(&target).map_err(|error| error.error)?;
+    File::open(root)?.sync_all()?;
+    Ok(())
+}
+
+pub fn retained(root: &Path) -> io::Result<bool> {
+    match fs::symlink_metadata(root.join(RETAIN_MARKER)) {
+        Ok(_) => Ok(true),
+        Err(error) if error.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(error) => Err(error),
+    }
+}
+
+pub fn retain_capture(root: &Path) -> io::Result<()> {
+    // Both the per-capture leaf and native per-sandbox root can be GC targets.
+    // Mark the ancestor first so a crash never leaves an unprotected subtree.
+    let parent = root
+        .parent()
+        .ok_or_else(|| io::Error::other("capture parent required"))?;
+    for directory in [parent, root] {
+        let mut file = OpenOptions::new()
+            .create(true)
+            .truncate(true)
+            .write(true)
+            .mode(0o600)
+            .open(directory.join(RETAIN_MARKER))?;
+        file.write_all(b"provider checkpoint reconciliation required\n")?;
+        file.sync_all()?;
+        File::open(directory)?.sync_all()?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn repository_observation_is_atomic_and_replayable() -> io::Result<()> {
+        let temporary = tempfile::tempdir()?;
+        let root = temporary.path().join("publications");
+        let repository = "a".repeat(64);
+        for _ in 0..2 {
+            persist_repository_observation(&root, &repository, "snapshot-id", "published")?;
+        }
+        let raw = fs::read(root.join(format!("{repository}_snapshot-id-published.json")))?;
+        let task: serde_json::Value = serde_json::from_slice(&raw)?;
+        assert_eq!(task["native_id"], "snapshot-id");
+        assert_eq!(task["action"], "published");
+        assert_eq!(task["version"], 1);
+        assert_eq!(fs::read_dir(&root)?.count(), 1);
+        for (id, action) in [
+            ("../escape", "published"),
+            ("snapshot-id", "../deleted"),
+            ("", "deleted"),
+        ] {
+            assert!(persist_repository_observation(&root, &repository, id, action).is_err());
+        }
+        persist_repository_observation(&root, &repository, "snapshot-id", "deleted")?;
+        assert!(root
+            .join(format!("{repository}_snapshot-id-deleted.json"))
+            .exists());
+        Ok(())
+    }
+    #[test]
+    fn capture_and_parent_remain_marked_across_reopen() -> io::Result<()> {
+        let temporary = tempfile::tempdir()?;
+        let parent = temporary.path().join("sandbox");
+        let capture = parent.join("capture");
+        fs::create_dir_all(&capture)?;
+        assert!(!retained(&parent)?);
+        retain_capture(&capture)?;
+        assert!(retained(&parent)?);
+        assert!(retained(&capture)?);
+        retain_capture(&capture)?;
+        assert!(retained(&capture)?);
+        Ok(())
+    }
+}
diff --git a/src/sandbox/storage/devices.rs b/src/sandbox/storage/devices.rs
new file mode 100644
index 0000000..d038bfd
--- /dev/null
+++ b/src/sandbox/storage/devices.rs
@@ -0,0 +1,578 @@
+//! Optional, generic external block-device provider. This module has no knowledge
+//! of Kubernetes, CSI or any particular storage framework.
+use std::fs::{self, File, OpenOptions};
+use std::io::Write;
+use std::os::unix::fs::{FileTypeExt, MetadataExt, OpenOptionsExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Mutex,
+};
+
+use anyhow::{Context, Result};
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+
+use super::StorageContext;
+use crate::cfg::ConfigManager;
+use crate::sandbox::extra_drive::{normalize_mount_path, DriveMount};
+use crate::types::SandboxId;
+
+#[derive(Clone, Debug, Serialize, Deserialize, PartialEq, Eq)]
+pub(crate) struct ExternalBlockDevice {
+    pub id: String,
+    pub path: PathBuf,
+    pub guest_path: PathBuf,
+    pub readonly: bool,
+    pub major: u32,
+    pub minor: u32,
+    pub bytes: u64,
+    pub uuid: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct Event {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    capture: Option<CaptureReceipt>,
+    sequence: u64,
+    ticket: String,
+    sandbox_id: String,
+    instance_id: String,
+    event: String,
+    owner_pid: u32,
+    owner_start: String,
+    pid: u32,
+    process_start: String,
+    boot_id: String,
+    #[serde(default)]
+    devices: Vec<ExternalBlockDevice>,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+struct CaptureReceipt {
+    barrier_id: String,
+    artifact: String,
+    digest: String,
+}
+
+#[derive(Deserialize)]
+struct Prepared {
+    devices: Vec<ExternalBlockDevice>,
+    resources: Resources,
+}
+#[derive(Deserialize)]
+struct Resources {
+    cpu: u32,
+    memory_mib: u64,
+}
+
+pub(crate) struct PreparedExternalDrives {
+    event: Mutex<Event>,
+    root: PathBuf,
+    url: String,
+    client: reqwest::Client,
+    context: StorageContext,
+    pause_retained: AtomicBool,
+    pub devices: Vec<ExternalBlockDevice>,
+}
+
+fn start_time(pid: u32) -> Result<String> {
+    let data = fs::read_to_string(format!("/proc/{pid}/stat"))?;
+    let (_, fields) = data.rsplit_once(')').context("invalid process identity")?;
+    Ok(fields
+        .split_whitespace()
+        .nth(19)
+        .context("short process identity")?
+        .to_owned())
+}
+
+impl PreparedExternalDrives {
+    pub async fn prepare(
+        id: SandboxId,
+        params: Option<&StorageContext>,
+        cpu: u32,
+        memory_mib: u64,
+    ) -> Result<Option<Self>> {
+        let cfg = &ConfigManager::global_config().storage_provider;
+        let Some(context) = params else {
+            return Ok(None);
+        };
+        anyhow::ensure!(
+            cfg.enabled,
+            "storage context supplied while provider disabled"
+        );
+        let ticket = context.ticket.clone();
+        anyhow::ensure!(ticket.len() >= 32, "storage ticket required");
+        let url = cfg
+            .url
+            .clone()
+            .context("storage provider is not configured")?;
+        let parsed = reqwest::Url::parse(&url)?;
+        anyhow::ensure!(
+            parsed.scheme() == "http"
+                && matches!(parsed.host_str(), Some("127.0.0.1" | "localhost" | "::1")),
+            "storage provider must use node-local loopback"
+        );
+        let root = cfg.state_dir.clone();
+        fs::create_dir_all(&root)?;
+        fs::set_permissions(&root, fs::Permissions::from_mode(0o700))?;
+        let owner_pid = std::process::id();
+        let mut this = Self {
+            event: Mutex::new(Event {
+                capture: None,
+                sequence: 1,
+                ticket,
+                sandbox_id: id.to_string(),
+                instance_id: Uuid::now_v7().to_string(),
+                event: "prepare".into(),
+                owner_pid,
+                owner_start: start_time(owner_pid)?,
+                pid: 0,
+                process_start: String::new(),
+                boot_id: fs::read_to_string("/proc/sys/kernel/random/boot_id")?
+                    .trim()
+                    .into(),
+                devices: Vec::new(),
+            }),
+            root,
+            url,
+            client: super::client()?,
+            context: context.clone(),
+            pause_retained: AtomicBool::new(false),
+            devices: Vec::new(),
+        };
+        this.persist()?;
+        let result = async {
+            let ev = this.event.lock().unwrap().clone();
+            let response = this
+                .client
+                .post(format!(
+                    "{}/storage/prepare",
+                    this.url.trim_end_matches('/')
+                ))
+                .json(&ev)
+                .send()
+                .await?
+                .error_for_status()?
+                .json::<Prepared>()
+                .await?;
+            anyhow::ensure!(
+                response.resources.cpu == cpu && response.resources.memory_mib == memory_mib,
+                "actual VM resources differ from the reserved launch"
+            );
+            anyhow::ensure!(
+                !response.devices.is_empty() || context.managed_mounts.is_empty(),
+                "storage provider omitted managed devices"
+            );
+            let device_root = if response.devices.is_empty() {
+                cfg.device_root.clone()
+            } else {
+                fs::canonicalize(&cfg.device_root)?
+            };
+            for d in &response.devices {
+                anyhow::ensure!(
+                    d.uuid.len() == 36
+                        && d.uuid.bytes().all(|b| b.is_ascii_hexdigit() || b == b'-'),
+                    "invalid filesystem UUID"
+                );
+                anyhow::ensure!(
+                    !d.id.is_empty()
+                        && d.id.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'_'),
+                    "invalid device ID"
+                );
+                let canonical = fs::canonicalize(&d.path)?;
+                anyhow::ensure!(
+                    canonical == d.path && canonical.starts_with(&device_root),
+                    "external device outside provider root"
+                );
+                let m = fs::metadata(&canonical)?;
+                anyhow::ensure!(
+                    m.file_type().is_block_device()
+                        && nix::libc::major(m.rdev()) == d.major
+                        && nix::libc::minor(m.rdev()) == d.minor,
+                    "external block identity differs"
+                );
+                anyhow::ensure!(
+                    normalize_mount_path(d.guest_path.clone())? == d.guest_path
+                        && d.bytes > 0
+                        && d.bytes % 512 == 0,
+                    "invalid external mount or capacity"
+                );
+            }
+            Ok::<_, anyhow::Error>(response.devices)
+        }
+        .await;
+        match result {
+            Ok(devices) => {
+                this.devices = devices;
+                Ok(Some(this))
+            }
+            Err(e) => {
+                let _ = this.stopped().await;
+                Err(e)
+            }
+        }
+    }
+
+    fn persist(&self) -> Result<()> {
+        let ev = self.event.lock().unwrap().clone();
+        let target = self.root.join(format!("{}.json", ev.instance_id));
+        let temp = self.root.join(format!("{}.tmp", ev.instance_id));
+        let mut file = OpenOptions::new()
+            .write(true)
+            .create(true)
+            .truncate(true)
+            .mode(0o600)
+            .open(&temp)?;
+        file.write_all(&serde_json::to_vec(&ev)?)?;
+        file.sync_all()?;
+        fs::rename(temp, target)?;
+        File::open(&self.root)?.sync_all()?;
+        Ok(())
+    }
+    async fn notify(&self) -> Result<()> {
+        let ev = self.event.lock().unwrap().clone();
+        self.client
+            .post(format!("{}/storage/event", self.url.trim_end_matches('/')))
+            .json(&ev)
+            .send()
+            .await?
+            .error_for_status()?;
+        Ok(())
+    }
+    /// Acquire the durable logical hold before creating paused memory or
+    /// releasing this run's attachments. A local boolean is never the authority.
+    pub async fn retain_pause(&self) -> Result<()> {
+        self.context.control("pause").await?;
+        self.pause_retained.store(true, Ordering::Release);
+        Ok(())
+    }
+    pub fn pause_retained(&self) -> bool {
+        self.pause_retained.load(Ordering::Acquire)
+    }
+    pub async fn cancel_pause(&self) -> Result<()> {
+        self.context.control("cancel_pause").await?;
+        self.pause_retained.store(false, Ordering::Release);
+        Ok(())
+    }
+
+    pub async fn before_launch(&self) -> Result<()> {
+        {
+            let mut ev = self.event.lock().unwrap();
+            ev.sequence += 1;
+            ev.event = "launching".into();
+        }
+        self.persist()?;
+        if let Err(e) = self.notify().await {
+            // This function has not allowed a spawn yet.
+            {
+                let mut ev = self.event.lock().unwrap();
+                ev.sequence += 1;
+                ev.event = "stopped".into();
+            }
+            self.persist()?;
+            return Err(e);
+        }
+        Ok(())
+    }
+    pub async fn starting(&self, pid: u32) -> Result<()> {
+        {
+            let mut ev = self.event.lock().unwrap();
+            ev.sequence += 1;
+            ev.event = "starting".into();
+            ev.pid = pid;
+            ev.process_start = start_time(pid)?;
+        }
+        self.persist()?;
+        self.notify().await
+    }
+    pub async fn ready(&self) -> Result<()> {
+        {
+            let mut ev = self.event.lock().unwrap();
+            if ev.event != "ready" {
+                ev.sequence += 1;
+                ev.event = "ready".into();
+                ev.capture = None;
+                ev.devices = self.devices.clone();
+            }
+            // A persisted ready event is not a controller acknowledgement.
+            // Retry delivery after an HTTP timeout before reporting VM ready.
+        }
+        self.persist()?;
+        self.notify().await
+    }
+    /// Called only while the original VMM is paused and every writable guest
+    /// volume is frozen. CSI details remain opaque to the native runtime.
+    pub fn retain_capture(&self, root: &Path, barrier: &str) -> Result<()> {
+        super::artifact_gc::retain(root, &self.context, barrier)
+    }
+    pub async fn capture(
+        &self,
+        barrier_id: String,
+        artifact: String,
+        digest: String,
+    ) -> Result<Option<serde_json::Value>> {
+        if self.devices.is_empty() {
+            return Ok(None);
+        }
+        let receipt = CaptureReceipt {
+            barrier_id,
+            artifact,
+            digest,
+        };
+        {
+            let mut ev = self.event.lock().unwrap();
+            anyhow::ensure!(ev.event == "ready", "capture requires a ready native run");
+            ev.sequence += 1;
+            ev.event = "capturing".into();
+            ev.capture = Some(receipt.clone());
+            ev.devices = self.devices.clone();
+        }
+        self.persist()?;
+        self.notify().await?;
+        let checkpoint = tokio::time::timeout(std::time::Duration::from_secs(300), async {
+            loop {
+                let result: serde_json::Value = self.client
+                    .post(format!("{}/storage/control", self.url.trim_end_matches('/')))
+                    .json(&serde_json::json!({"ticket": self.context.ticket, "action":"capture", "capture": receipt}))
+                    .send().await?.error_for_status()?.json().await?;
+                match result.get("ready").and_then(serde_json::Value::as_bool) {
+                    Some(true) => return result.get("checkpoint").cloned().context("missing joint checkpoint"),
+                    Some(false) => tokio::time::sleep(std::time::Duration::from_millis(250)).await,
+                    None => anyhow::bail!("invalid provider capture response"),
+                }
+            }
+        }).await.context("joint storage capture timed out")??;
+        Ok(Some(checkpoint))
+    }
+
+    /// Invalidate the durable barrier before resuming vCPUs. A controller that
+    /// races an HTTP timeout must not observe a stale capturing receipt.
+    pub async fn begin_thaw(&self) -> Result<()> {
+        {
+            let mut ev = self.event.lock().unwrap();
+            if ev.event != "capturing" && ev.event != "thawing" {
+                return Ok(());
+            }
+            if ev.event != "thawing" {
+                ev.sequence += 1;
+                ev.event = "thawing".into();
+                ev.capture = None;
+            }
+        }
+        self.persist()?;
+        self.notify().await
+    }
+
+    pub async fn stopped(&self) -> Result<()> {
+        {
+            let mut ev = self.event.lock().unwrap();
+            anyhow::ensure!(
+                ev.event != "launching" || ev.pid != 0,
+                "spawn outcome unknown; retain external storage until process fencing"
+            );
+            anyhow::ensure!(
+                ev.pid == 0
+                    || start_time(ev.pid).ok().as_deref() != Some(ev.process_start.as_str()),
+                "external storage still owned by VMM"
+            );
+            if ev.event != "stopped" {
+                ev.sequence += 1;
+                ev.event = "stopped".into();
+            }
+        }
+        self.persist()?;
+        // The fsynced record is also consumed by the sidecar recovery worker.
+        if let Err(e) = self.notify().await {
+            tracing::warn!(error=%e, "external storage stop notification deferred to durable journal");
+        }
+        Ok(())
+    }
+    pub fn validate_native_drives(
+        &self,
+        native: &[crate::sandbox::extra_drive::ExtraDrive],
+        physical_count: usize,
+        slots: usize,
+        readonly_slots: usize,
+    ) -> Result<()> {
+        anyhow::ensure!(
+            physical_count <= native.len(),
+            "invalid physical drive count"
+        );
+        anyhow::ensure!(
+            physical_count.checked_add(slots).is_some_and(|n| n <= 24),
+            "external volume slots exceed guest block-device names"
+        );
+        self.assignments(slots, readonly_slots, native.len() - physical_count)?;
+        let mut paths = native
+            .iter()
+            .map(|d| d.mount_path().to_path_buf())
+            .collect::<Vec<_>>();
+        let mut ids = std::collections::HashSet::new();
+        for device in &self.devices {
+            anyhow::ensure!(
+                ids.insert(device.id.as_str()),
+                "duplicate external device ID"
+            );
+            for path in &paths {
+                anyhow::ensure!(
+                    !path.starts_with(&device.guest_path) && !device.guest_path.starts_with(path),
+                    "external mount overlaps another drive: {}",
+                    device.guest_path.display()
+                );
+            }
+            paths.push(device.guest_path.clone());
+        }
+        Ok(())
+    }
+
+    pub fn assignments(
+        &self,
+        slots: usize,
+        readonly_slots: usize,
+        occupied: usize,
+    ) -> Result<Vec<(usize, &ExternalBlockDevice)>> {
+        anyhow::ensure!(
+            readonly_slots <= slots && occupied <= slots - readonly_slots,
+            "incompatible external storage slot manifest"
+        );
+        let mut rw = occupied;
+        let mut ro = slots - readonly_slots;
+        let mut out = Vec::new();
+        for d in &self.devices {
+            let index = if d.readonly {
+                let i = ro;
+                ro += 1;
+                anyhow::ensure!(i < slots, "template has no free readonly block slot");
+                i
+            } else {
+                let i = rw;
+                rw += 1;
+                anyhow::ensure!(
+                    i < slots - readonly_slots,
+                    "template has no free writable block slot"
+                );
+                i
+            };
+            out.push((index, d));
+        }
+        Ok(out)
+    }
+    pub fn assignments_layout(
+        &self,
+        slots: usize,
+        readonly_slots: usize,
+        occupied: usize,
+        layout: &std::collections::BTreeMap<String, usize>,
+    ) -> Result<Vec<(usize, &ExternalBlockDevice)>> {
+        if layout.is_empty() {
+            return self.assignments(slots, readonly_slots, occupied);
+        }
+        let mut used = std::collections::HashSet::new();
+        self.devices
+            .iter()
+            .map(|device| {
+                let path = device
+                    .guest_path
+                    .to_str()
+                    .context("invalid guest device path")?;
+                let slot = *layout
+                    .get(path)
+                    .context("external device missing from stable layout")?;
+                anyhow::ensure!(
+                    slot < slots && used.insert(slot),
+                    "external device slot collision"
+                );
+                anyhow::ensure!(
+                    (slot >= slots - readonly_slots) == device.readonly,
+                    "external readonly slot mismatch"
+                );
+                Ok((slot, device))
+            })
+            .collect()
+    }
+    pub fn mount(d: &ExternalBlockDevice) -> DriveMount {
+        DriveMount {
+            drive_id: d.id.clone(),
+            attachment_path: d.path.clone(),
+            read_only: d.readonly,
+        }
+    }
+}
+
+impl Drop for PreparedExternalDrives {
+    fn drop(&mut self) {
+        // Before process launch there is no asynchronous actor that may acquire
+        // these devices. After launch, only observed process exit is evidence.
+        let mut ev = self.event.lock().unwrap();
+        if ev.pid == 0 && ev.event == "prepare" {
+            ev.sequence += 1;
+            ev.event = "stopped".into();
+            drop(ev);
+            let _ = self.persist();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn readonly_devices_use_only_readonly_slots() {
+        let device = ExternalBlockDevice {
+            id: "disk".into(),
+            path: "/device".into(),
+            guest_path: "/data".into(),
+            readonly: true,
+            major: 1,
+            minor: 1,
+            bytes: 4096,
+            uuid: "00000000-0000-0000-0000-000000000000".into(),
+        };
+        let mut session = PreparedExternalDrives {
+            event: Mutex::new(Event {
+                capture: None,
+                sequence: 1,
+                ticket: "test".into(),
+                sandbox_id: "sandbox".into(),
+                instance_id: "instance".into(),
+                event: "starting".into(),
+                owner_pid: 1,
+                owner_start: "1".into(),
+                pid: 1,
+                process_start: "1".into(),
+                boot_id: "boot".into(),
+                devices: Vec::new(),
+            }),
+            root: PathBuf::new(),
+            url: String::new(),
+            client: reqwest::Client::new(),
+            context: StorageContext {
+                ticket: "test".into(),
+                owner_uid: "owner".into(),
+                run_uid: "run".into(),
+                request_id: "request".into(),
+                template_pin: String::new(),
+                checkpoint_source: String::new(),
+                managed_mounts: Vec::new(),
+                native_id: String::new(),
+                replace_mounts: false,
+                relocations: Vec::new(),
+            },
+            pause_retained: AtomicBool::new(false),
+            devices: vec![device],
+        };
+        assert!(session.assignments(8, 0, 0).is_err());
+        assert_eq!(session.assignments(5, 1, 4).unwrap()[0].0, 4);
+        assert_eq!(session.assignments(8, 2, 0).unwrap()[0].0, 6);
+        assert!(session.assignments(8, 2, 7).is_err());
+        assert!(session.validate_native_drives(&[], 0, 8, 2).is_ok());
+        assert!(session.validate_native_drives(&[], 1, 8, 2).is_err());
+        assert!(session.validate_native_drives(&[], 0, 25, 2).is_err());
+        let mut overlapping = session.devices[0].clone();
+        overlapping.id = "second".into();
+        overlapping.guest_path = "/data/child".into();
+        session.devices.push(overlapping);
+        assert!(session.validate_native_drives(&[], 0, 8, 2).is_err());
+    }
+}
