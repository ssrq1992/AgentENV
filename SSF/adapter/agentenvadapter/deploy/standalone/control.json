{
  "namespace": "agentenv-system",
  "principal": {
    "tenant": "agentenv",
    "namespaces": [
      "agentenv-system"
    ]
  },
  "recovery_seconds": 30,
  "drivers": [
    {
      "Name": "example.csi.driver",
      "ControllerEndpoint": "ssf-csi-gateway.ssf-system.svc:9443",
      "Revision": "1"
    }
  ],
  "signing_key": "/etc/agentenv-storage/plan.key",
  "cert": "/etc/agentenv-storage-control-tls/tls.crt",
  "key": "/etc/agentenv-storage-control-tls/tls.key",
  "ca": "/etc/agentenv-storage-control-tls/ca.crt",
  "agent_key_file": "/etc/agentenv-native-auth/AENV_API_KEY",
  "dispatch_key_file": "/etc/agentenv-storage/dispatch-key",
  "plugin_port": "9444",
  "plugin_server_name": "localhost",
  "required_profile": "agentenv-capture-clone-v1",
  "standalone": {
    "node_id": "agentenv-host",
    "kube_node": "worker-1",
    "endpoint": "http://127.0.0.1:8000",
    "plugin_url": "https://127.0.0.1:9444"
  },
  "kubeconfig": "/etc/agentenv-storage/kubeconfig",
  "volume_profiles": [
    {
      "name": "agentenv-block-ext4-v1",
      "runtime": "agentenv",
      "version": "volume-preparation-v1",
      "volumeMode": "Block",
      "filesystem": "ext4",
      "initializeBlank": true
    }
  ],
  "preparation_node_port": "9443",
  "preparation_server_name": "localhost"
}
