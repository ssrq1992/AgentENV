                  },
                  {
                    "name": "runtime",
                    "mountPath": "/var/lib/agentenv-external"
                  },
                  {
                    "name": "state",
                    "mountPath": "/var/lib/ssf",
                    "mountPropagation": "HostToContainer"
                  },
                  {
                    "name": "native-key",
                    "mountPath": "/native-key",
